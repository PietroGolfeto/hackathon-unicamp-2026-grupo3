# DOMAIN=acordos.exemplo.com.br → TLS automático. DOMAIN=":8080" → HTTP puro (dev/standby).
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
