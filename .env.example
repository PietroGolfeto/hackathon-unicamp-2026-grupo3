# Copie para .env na raiz. Nada aqui é segredo de verdade; troque SECRET_KEY e DEMO_TOKEN na VPS.

# Postgres (compose cria o banco com estes valores)
POSTGRES_USER=enter
POSTGRES_PASSWORD=enter
POSTGRES_DB=enter
# API rodando fora do compose (make dev-api) fala com o Postgres do compose em localhost
DATABASE_URL=postgresql+psycopg://enter:enter@localhost:5432/enter

# Sessão (cookie assinado) e link mágico da banca: /api/demo?t=<DEMO_TOKEN>
SECRET_KEY=troque-por-uma-frase-longa-e-aleatoria
DEMO_TOKEN=troque-tambem

# Domínio do Caddy. ":8080" = local sem TLS; "acordos.seudominio.com.br" = TLS automático na VPS
DOMAIN=:8080

# Onde estão os 2 CSVs da Enter e a pasta exemplos/ (fora do compose; dentro dele é /data)
DATA_DIR=./data

# Engine de política e backtest (src/enteros): planilha bruta da Enter (não versionada).
# Sem ela, `make data/train/backtest` rodam sobre data/exemplos/sinteticos.csv.
ENTEROS_RAW_XLSX=data/raw/Hackaton_Enter_Base_Candidatos.xlsx

# Implementações de P1 e P3 no portal ("pacote.modulo:Classe"). Se o import falhar, a API usa stubs.
# Padrão: adapter sobre o engine de src/enteros (models/*.json)
MODEL_IMPL=app.modelo_enteros:ModeloEnteros
EXTRACTOR_IMPL=extractor.pipeline:Extrator

# OpenAI: só o extractor (P3) usa. Sem chave ele responde apenas do cache; sem cache, o ingest avisa e não extrai.
# O resultado de cada processo fica em DATA_DIR/cache/extractor (ou EXTRACTOR_CACHE_DIR); mesmos PDFs = zero chamadas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# EXTRACTOR_CACHE_DIR=./data/cache/extractor

# Deploy (make deploy / make backup)
VPS_HOST=usuario@ip-da-vps
VPS_DIR=/srv/enter
