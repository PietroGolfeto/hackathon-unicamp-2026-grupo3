# Copie para .env e preencha. Nada aqui é obrigatório para rodar engine, backtest e API.
# A trilha de IA documental (leitura dos PDFs) usa a chave; sem ela, cai no fallback por regex.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Caminho da base bruta (não versionada). Sem ela, tudo roda sobre data/exemplos/sinteticos.csv.
ENTEROS_RAW_XLSX=data/raw/Hackaton_Enter_Base_Candidatos.xlsx
